{
  "name": "minecraft-human-builder",
  "version": "1.23.0",
  "private": true,
  "description": "Construction-aware, physically constrained Minecraft schematic builder.",
  "main": "start-render.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20 <27"
  },
  "scripts": {
    "start": "node start-render.js",
    "cli": "node src/index.js",
