  },
  "dependencies": {
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "https://github.com/PrismarineJS/mineflayer-pathfinder/archive/refs/heads/master.tar.gz",
    "minecraft-data": "3.117.0",
    "prismarine-block": "1.23.0",
    "prismarine-schematic": "1.3.0",
    "prismarine-world": "3.7.0",
    "vec3": "0.1.10"
